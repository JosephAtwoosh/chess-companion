# Chess Companion on Apache: only the static app and api.php are public.
Options -Indexes
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^data(/|$) - [F,L]
</IfModule>
<FilesMatch "\.(md|json|txt|log|ini|py)$">
  Require all denied
</FilesMatch>
<FilesMatch "^(manifest\.webmanifest)$">
  Require all granted
</FilesMatch>
AddType application/manifest+json .webmanifest
