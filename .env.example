# Copy to .env and fill in.  Never commit .env.

# Passwords, used on the very first start only (afterwards change them in the app's Family settings).
CC_FAMILY_PASSWORD=choose-a-family-password
CC_ADMIN_PASSWORD=choose-a-different-admin-password

# OpenRouter (https://openrouter.ai/keys). Pay per use; set a credit limit on the key at OpenRouter too.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-5.5

# Who gets AI wording: "all" or a comma list of player ids. Others get the engine's own words.
CC_AI_PROFILES=all
# Spending caps (requests): whole family per day, and per player per hour.
CC_AI_PER_DAY=150
CC_AI_PER_PROFILE_PER_HOUR=20

# Behind a reverse proxy (Caddy, nginx, Traefik) that sets X-Forwarded-For:
# CC_TRUST_PROXY=1
